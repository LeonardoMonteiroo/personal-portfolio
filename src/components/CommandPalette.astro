---
import { cases } from '../data/cases';
import { site, t } from '../i18n/ui';
import { localePath, url, type Lang } from '../lib/resume';

interface Props {
  lang: Lang;
  path: string;
}

const { lang, path } = Astro.props;
const ui = t(lang);
const p = ui.palette;
const other: Lang = lang === 'en' ? 'pt' : 'en';

type Item = { id: string; label: string; group: string; href?: string; action?: string; keywords?: string; external?: boolean };

const items: Item[] = [
  ...(['experience', 'cases', 'projects', 'stack', 'about', 'contact'] as const).map((id) => ({
    id: `nav-${id}`,
    label: ui.nav[id],
    group: p.groupNav,
    href: localePath(lang, `#${id}`),
  })),
  { id: 'act-email', label: p.copyEmail, group: p.groupActions, action: 'copy-email', keywords: `email e-mail contact contato ${site.email}` },
  { id: 'act-cv', label: p.downloadCv, group: p.groupActions, href: url(site.cv[lang]), keywords: 'cv resume curriculo pdf' },
  { id: 'act-lang', label: p.switchLang, group: p.groupActions, href: localePath(other, path), keywords: 'language idioma english portugues' },
  { id: 'act-theme', label: p.toggleTheme, group: p.groupActions, action: 'toggle-theme', keywords: 'dark light tema' },
  { id: 'act-github', label: p.github, group: p.groupActions, href: site.github, external: true, keywords: 'code repositories' },
  { id: 'act-linkedin', label: p.linkedin, group: p.groupActions, href: site.linkedin, external: true },
  ...cases.map((c) => ({
    id: `case-${c.slug}`,
    label: c[lang].title,
    group: p.groupCases,
    href: localePath(lang, `cases/${c.slug}/`),
    keywords: c.stack.join(' '),
  })),
];
const groups = [...new Set(items.map((i) => i.group))];
---

<dialog class="palette" aria-label={p.title} data-palette data-email={site.email} data-copied={p.copied}>
  <div class="palette-box">
    <div class="palette-input-row">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"
        ><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg
      >
      <input
        type="text"
        role="combobox"
        aria-expanded="true"
        aria-controls="palette-list"
        aria-autocomplete="list"
        aria-label={p.placeholder}
        placeholder={p.placeholder}
        autocomplete="off"
        spellcheck="false"
        data-palette-input
      />
      <kbd class="mono">Esc</kbd>
    </div>
    <ul id="palette-list" role="listbox" class="palette-list" aria-label={p.title}>
      {
        groups.map((g) => (
          <li role="presentation" class="palette-group" data-group={g}>
            <span class="palette-group-label mono" aria-hidden="true">
              {g}
            </span>
            <ul role="group" aria-label={g}>
              {items
                .filter((i) => i.group === g)
                .map((i) => (
                  <li
                    role="option"
                    id={i.id}
                    aria-selected="false"
                    class="palette-item"
                    data-href={i.href}
                    data-action={i.action}
                    data-external={i.external ? 'true' : undefined}
                    data-search={`${i.label} ${i.keywords ?? ''}`.toLowerCase()}
                  >
                    {i.label}
                  </li>
                ))}
            </ul>
          </li>
        ))
      }
    </ul>
    <p class="palette-empty" hidden data-palette-empty>{p.empty}</p>
    <div class="palette-foot mono" aria-hidden="true">
      <span><kbd>↑</kbd><kbd>↓</kbd> {p.hint}</span>
      <span><kbd>↵</kbd></span>
    </div>
  </div>
  <p class="palette-toast" role="status" aria-live="polite" data-palette-toast></p>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-palette]')!;
  const input = dialog.querySelector<HTMLInputElement>('[data-palette-input]')!;
  const empty = dialog.querySelector<HTMLElement>('[data-palette-empty]')!;
  const toast = dialog.querySelector<HTMLElement>('[data-palette-toast]')!;
  const options = [...dialog.querySelectorAll<HTMLElement>('[role="option"]')];
  const groups = [...dialog.querySelectorAll<HTMLElement>('.palette-group')];
  let visible: HTMLElement[] = options;
  let active = 0;
  let opener: HTMLElement | null = null;

  function normalize(s: string) {
    return s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
  }

  function setActive(index: number) {
    if (!visible.length) {
      input.removeAttribute('aria-activedescendant');
      return;
    }
    active = (index + visible.length) % visible.length;
    options.forEach((o) => o.setAttribute('aria-selected', 'false'));
    const el = visible[active];
    el.setAttribute('aria-selected', 'true');
    input.setAttribute('aria-activedescendant', el.id);
    el.scrollIntoView({ block: 'nearest' });
  }

  function filter() {
    const q = normalize(input.value.trim());
    visible = [];
    for (const o of options) {
      const match = !q || normalize(o.dataset.search ?? '').includes(q);
      o.hidden = !match;
      if (match) visible.push(o);
    }
    groups.forEach((g) => (g.hidden = !g.querySelector('[role="option"]:not([hidden])')));
    empty.hidden = visible.length > 0;
    setActive(0);
  }

  function open() {
    if (dialog.open) return;
    opener = document.activeElement as HTMLElement | null;
    input.value = '';
    toast.textContent = '';
    filter();
    dialog.showModal();
    input.focus();
  }

  function close() {
    if (dialog.open) dialog.close();
  }

  dialog.addEventListener('close', () => opener?.focus());

  async function run(el: HTMLElement) {
    const { href, action, external } = el.dataset;
    if (action === 'copy-email') {
      const email = dialog.dataset.email!;
      try {
        await navigator.clipboard.writeText(email);
        toast.textContent = dialog.dataset.copied!;
        setTimeout(close, 900);
      } catch {
        window.location.href = `mailto:${email}`;
      }
      return;
    }
    if (action === 'toggle-theme') {
      document.dispatchEvent(new Event('toggle-theme'));
      close();
      return;
    }
    if (href) {
      close();
      if (external) window.open(href, '_blank', 'noopener');
      else window.location.href = href;
    }
  }

  input.addEventListener('input', filter);
  input.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      setActive(active + 1);
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      setActive(active - 1);
    } else if (e.key === 'Enter') {
      e.preventDefault();
      if (visible[active]) run(visible[active]);
    }
  });

  options.forEach((o) => {
    o.addEventListener('click', () => run(o));
    o.addEventListener('mousemove', () => {
      const i = visible.indexOf(o);
      if (i !== active && i >= 0) setActive(i);
    });
  });

  dialog.addEventListener('click', (e) => {
    if (e.target === dialog) close();
  });

  document.querySelectorAll('[data-palette-open]').forEach((b) => b.addEventListener('click', open));
  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      dialog.open ? close() : open();
    }
  });
</script>

<style>
  .palette {
    width: min(640px, calc(100vw - 32px));
    max-height: min(560px, calc(100vh - 96px));
    margin: 12vh auto auto;
    padding: 0;
    border: 1px solid var(--border-strong);
    border-radius: 12px;
    background: var(--panel);
    color: var(--text);
    box-shadow: 0 24px 64px -12px rgb(0 0 0 / 0.55);
    overflow: hidden;
  }

  .palette[open] {
    display: flex;
  }

  .palette::backdrop {
    background: rgb(5 6 8 / 0.6);
    backdrop-filter: blur(3px);
  }

  .palette-box {
    display: flex;
    flex-direction: column;
    width: 100%;
    min-height: 0;
  }

  .palette-input-row {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--border);
    color: var(--muted);
  }

  .palette-input-row input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: transparent;
    color: var(--text);
    font: inherit;
    font-size: 16px;
    outline: none;
  }

  kbd {
    padding: 1px 6px;
    border-radius: 4px;
    border: 1px solid var(--border);
    background: var(--panel-2);
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--muted);
  }

  .palette-list {
    list-style: none;
    overflow-y: auto;
    padding: 6px;
    min-height: 0;
  }

  .palette-list ul {
    list-style: none;
  }

  .palette-group-label {
    display: block;
    padding: 10px 10px 4px;
    font-size: 11px;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .palette-item {
    padding: 9px 10px;
    border-radius: var(--radius-sm);
    font-size: 14px;
    color: var(--text-2);
    cursor: pointer;
  }

  .palette-item[aria-selected='true'] {
    background: var(--accent-soft);
    color: var(--text);
    box-shadow: inset 2px 0 0 var(--accent);
  }

  .palette-empty {
    padding: 24px 16px;
    color: var(--muted);
    text-align: center;
  }

  .palette-foot {
    display: flex;
    justify-content: space-between;
    padding: 8px 14px;
    border-top: 1px solid var(--border);
    font-size: 11px;
    color: var(--muted);
  }

  .palette-foot kbd {
    margin-right: 2px;
  }

  .palette-toast {
    position: absolute;
    right: 14px;
    top: 14px;
    color: var(--ok);
    font-size: 13px;
    font-weight: 500;
  }

  .palette-toast:empty {
    display: none;
  }

  @media (max-width: 520px) {
    .palette-foot {
      display: none;
    }
  }
</style>
